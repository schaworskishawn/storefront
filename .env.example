# Saleor API URL (required) - keep the trailing slash
NEXT_PUBLIC_SALEOR_API_URL=https://your-instance.saleor.cloud/graphql/

# Storefront URL - set on production for correct canonical URLs and OG images
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Mobile dev via ngrok / LAN — hostnames only (no https://), comma-separated.
# Required when a real device loads the dev server through a tunnel; restart pnpm dev after change.
# ALLOWED_DEV_ORIGINS=servilely-quare-polly.ngrok-free.dev

# Checkout-only deploy (optional) — absolute checkout links from storefront and redirect allowlist
# NEXT_PUBLIC_CHECKOUT_URL=https://checkout.example.com

# Channel slug (required) - fallback when STOREFRONT_CHANNELS is not set
# Used to fetch catalog data on this fork's flat routes (/home, /shop, …). The root "/" itself
# redirects to /home (see middleware.ts), not to this channel directly.
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Storefront channel allowlist (recommended for multi-channel) — comma-separated slugs
# Only these channels get routes, cache invalidation, and footer selector entries.
# STOREFRONT_CHANNELS=us,uk,eu

# Storefront locale allowlist — comma-separated URL slugs (e.g. en,pl,de,fr,fi,nb).
# Must be NEXT_PUBLIC_* so client components (checkout logo, locale links) match SSR.
# NEXT_PUBLIC_STOREFRONT_LOCALES=en,pl,de,fr,fi,nb
# NEXT_PUBLIC_DEFAULT_LOCALE=en

# Storefront marketing copy: code (defaults) | saleor (Saleor Models)
# CONTENT_PROVIDER=saleor

# Optional typography theme examples — default is Geist-only (Direction C).
# See config/themes/README.md and config/themes/typography-editorial.env.example
# Or: pnpm run dev:theme-editorial
# NEXT_PUBLIC_TYPOGRAPHY_THEME=editorial

# App token (optional) — narrow runtime token for channel discovery etc. (server-side only)
# SALEOR_APP_TOKEN=

# Configurator (dev/staging only) — NOT loaded by Next.js. Copy .env.configurator.local.example
# SALEOR_CONFIGURATOR_TOKEN lives in .env.configurator.local — see config/saleor/README.md

# Opt-in: discover ALL active Saleor channels from API (not recommended when Saleor has many channels).
# Prefer STOREFRONT_CHANNELS instead. Requires SALEOR_APP_TOKEN.
# STOREFRONT_DISCOVER_CHANNELS=true

# Site-wide password gate (pre-launch / staging lock). Off unless set: every page (not /api) then asks for it
# on /site-password. Change or remove it to lock everyone out again / open the site back up.
# SITE_PASSWORD=
# Optional: signs the access cookie; set to a random string (defaults to a built-in key).
# SITE_PASSWORD_SECRET=

# Cache invalidation — use ≥32 character random strings in production
# Manual revalidation: GET /api/cache-info and GET /api/revalidate (Authorization: Bearer header)
# REVALIDATE_SECRET=
# Saleor webhook HMAC for POST /api/revalidate (Dashboard → Configuration → Webhooks)
# SALEOR_WEBHOOK_SECRET=

# Checkout — Dummy Payment (local/staging test orders)
# Enabled automatically in development. Set to true on cloud/staging to allow dummy checkout.
# ALLOW_DUMMY_PAYMENT=true
# NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# Checkout — Stripe Elements (Saleor Stripe app)
# Required on cloud/staging (NODE_ENV=production). Auto-enabled in local development.
# Publishable keys come from Saleor paymentGatewayInitialize — configure Stripe in Saleor Dashboard.
# NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
# ENABLE_STRIPE_PAYMENTS=true
# Express Checkout wallets (Apple Pay, Google Pay, Link) on payment step — on when Stripe is enabled.
# NEXT_PUBLIC_ENABLE_STRIPE_EXPRESS_CHECKOUT=false

# Checkout contact step — "Email me with news and offers" (on by default; persisted as checkout metadata).
# NEXT_PUBLIC_ENABLE_CHECKOUT_MARKETING_OPT_IN=false

# Checkout — Verify Identity step (Stripe Identity — a *separate* Stripe product from payments;
# Saleor's Stripe payment app never exposes a secret key to this app, so Identity needs its own).
# Adds a required "Verify Identity" step before payment; only appears once both keys below are set.
# 1. Stripe Dashboard → Identity → enable the product, get a secret + publishable key pair
#    (these can be from the SAME Stripe account as payments, but are a different key pair).
# 2. Stripe Dashboard → Developers → Webhooks → add https://your-site.com/api/webhooks/stripe-identity
#    listening for identity.verification_session.{verified,requires_input,processing,canceled}.
# 3. The Saleor app behind SALEOR_APP_TOKEN needs MANAGE_CHECKOUTS permission — the webhook uses
#    the app token (no shopper session) to persist the result on checkout metadata.
# NEXT_PUBLIC_ENABLE_IDENTITY_VERIFICATION=false
# STRIPE_IDENTITY_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_IDENTITY_PUBLISHABLE_KEY=
# STRIPE_IDENTITY_WEBHOOK_SECRET=

# Checkout — Verify Identity step, AgeChecker.Net provider (purpose-built for age-restricted
# retail — vape/alcohol/tobacco). Independent of the Stripe Identity vars above; if both are set,
# AgeChecker takes priority (see checkout/lib/identity-verification/provider.ts). No npm package
# needed — it's a plain REST API.
# Get the domain API key from your AgeChecker.Net account → Websites tab. It's meant to be public
# (their own docs embed it in a client-side <script> tag), so it's a NEXT_PUBLIC_ var.
# NEXT_PUBLIC_ENABLE_AGECHECKER_VERIFICATION=false
# NEXT_PUBLIC_AGECHECKER_API_KEY=
# Optional — the separate account *secret* key (also on the Websites tab). Only needed for a
# custom min_age override or webhook callbacks; without it, verification still works via
# AgeChecker's account/site-level default minimum age and polling for the result.
# AGECHECKER_ACCOUNT_SECRET=

# WhatsApp live chat (business number, international format, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Card payments through Authorize.net — "Worldwide Vapor Payments", a small Saleor payment app that lives in this
# storefront (src/app/api/saleor-app/*, src/lib/payments-app/*). Saleor has no ready-made Authorize.net app.
# One-time setup:
#   1. Get an Authorize.net account AND a merchant account that accepts your business (vape/nicotine is usually
#      "high-risk" — the bank/acquirer, not Authorize.net alone, decides). Test first with a free sandbox account:
#      https://developer.authorize.net/hello_world/sandbox.html
#   2. Account → Settings → API Credentials & Keys: copy the API Login ID and Transaction Key, and create a Public Client Key.
#   3. Fill in the four AUTHORIZENET_* values below (server-only; the transaction key must never be NEXT_PUBLIC_).
#   4. Deploy, then in Saleor Dashboard → Apps → Install external app, use https://<your-domain>/api/saleor-app/manifest
#      (Saleor must be able to reach it, so not localhost). Make sure the app is assigned to your channel's payment settings.
#   5. Set NEXT_PUBLIC_ENABLE_AUTHORIZENET_PAYMENTS=true. While it is on, it takes over card payments from Stripe.
# NEXT_PUBLIC_ENABLE_AUTHORIZENET_PAYMENTS=true
# AUTHORIZENET_API_LOGIN_ID=
# AUTHORIZENET_TRANSACTION_KEY=
# AUTHORIZENET_CLIENT_KEY=
# "sandbox" (default, test cards only) or "production" (real charges)
# AUTHORIZENET_ENVIRONMENT=sandbox
# "authCapture" (default: charge immediately) or "authOnly" (authorise now, capture when you fulfil)
# AUTHORIZENET_TRANSACTION_TYPE=authCapture

# Interac e-Transfer (src/lib/etransfer.ts) — Canada-only, pay-after-order. The shopper places the order unpaid, gets the
# transfer details by email (via Resend, see below) and on the confirmation page; you mark the order paid in the Saleor
# Dashboard when the money arrives. REQUIRES "Allow unpaid orders" on the channel (Dashboard → Configuration → Channels),
# and the checkout currency must be CAD. For customer emails to deliver, verify your sending domain in Resend and set
# AFFILIATE_FROM_EMAIL to an address on it.
# NEXT_PUBLIC_ENABLE_ETRANSFER=true
# Interac only moves Canadian dollars, so the option is offered for CAD orders only. If your channel prices in another
# currency (e.g. USD) and you accept the CAD equivalent, list it here — the order page and email then tell customers to
# send the CAD equivalent. Comma-separated, default CAD.
# NEXT_PUBLIC_ETRANSFER_CURRENCIES=CAD,USD
# Interac needs a Canadian bank account, so the option is offered to customers in Canada only (by shipping country).
# Comma-separated ISO codes to widen that. Default CA.
# NEXT_PUBLIC_ETRANSFER_COUNTRIES=CA
# ETRANSFER_EMAIL=payments@yourdomain.com
# ETRANSFER_DEADLINE_HOURS=48
# Optional — only if your bank account does NOT use Interac auto-deposit (set both or neither):
# ETRANSFER_SECURITY_QUESTION=
# ETRANSFER_SECURITY_ANSWER=

# Affiliate applications (/api/affiliate). Set ONE of these so applications reach you online:
# Email via Resend (https://resend.com) — key + the inbox that should receive applications
RESEND_API_KEY=
AFFILIATE_INBOX_EMAIL=support@worldwidevapor.com
# Sender must be a domain verified in Resend (default uses Resend's test sender)
AFFILIATE_FROM_EMAIL=
# ...or forward as JSON to Zapier / Make / Slack / a CRM
AFFILIATE_WEBHOOK_URL=
RESEND_AUDIENCE_ID=
