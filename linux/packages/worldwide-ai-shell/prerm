#!/bin/sh
# Unloads the window's AppArmor profile before the window is removed.
set -e
if [ "$1" = "remove" ] && command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor/policy ]; then
	apparmor_parser --remove /etc/apparmor.d/worldwide-ai-shell 2>/dev/null || true
fi
exit 0
