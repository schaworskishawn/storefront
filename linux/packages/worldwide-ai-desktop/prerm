#!/bin/sh
# Gives the start-up screen back to Ubuntu's before the Worldwide AI one is removed.
set -e
theme=/usr/share/plymouth/themes/worldwide-ai/worldwide-ai.plymouth
if [ "$1" = "remove" ]; then
	update-alternatives --remove default.plymouth "$theme" || true
	if command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u || true
	fi
fi
exit 0
