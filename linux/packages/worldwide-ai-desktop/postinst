#!/bin/sh
# Makes the Worldwide AI start-up screen the default and rebuilds the start-up image so it is used from the next boot.
# The desktop settings need nothing here: dpkg compiles the settings schemas itself when the package is installed.
set -e
theme=/usr/share/plymouth/themes/worldwide-ai/worldwide-ai.plymouth
if [ "$1" = "configure" ]; then
	update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$theme" 150
	update-alternatives --set default.plymouth "$theme"
	if command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u
	fi
fi
exit 0
