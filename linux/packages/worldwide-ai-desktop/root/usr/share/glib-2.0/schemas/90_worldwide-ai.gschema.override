# Worldwide AI OS: how the desktop and the login screen look by default.
#
# Ubuntu sets its own defaults in 10_ubuntu-settings.gschema.override, for the "ubuntu" session and the login screen
# ("GNOME-Greeter"). This file sorts after it, so these win. They are defaults only: anyone can change them in Settings,
# and removing the package brings Ubuntu's back.

[org.gnome.desktop.background:ubuntu]
picture-uri = 'file:///usr/share/backgrounds/worldwide-ai/worldwide-ai-grid.svg'
picture-uri-dark = 'file:///usr/share/backgrounds/worldwide-ai/worldwide-ai-grid.svg'
picture-options = 'zoom'
primary-color = '#05030A'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri = 'file:///usr/share/backgrounds/worldwide-ai/worldwide-ai-grid.svg'
picture-options = 'zoom'
primary-color = '#05030A'

[org.gnome.desktop.background:GNOME-Greeter]
picture-uri = 'file:///usr/share/backgrounds/worldwide-ai/worldwide-ai-grid.svg'
picture-uri-dark = 'file:///usr/share/backgrounds/worldwide-ai/worldwide-ai-grid.svg'

[org.gnome.desktop.interface:ubuntu]
color-scheme = 'prefer-dark'
accent-color = 'teal'
gtk-theme = 'Yaru-prussiangreen-dark'

[org.gnome.shell:ubuntu]
favorite-apps = [ 'worldwide-ai.desktop', 'firefox_firefox.desktop', 'org.gnome.Nautilus.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Settings.desktop' ]

[org.gnome.login-screen]
logo = '/usr/share/worldwide-ai/login-logo.svg'
