{
  "name": "@locofy/cli",
  "version": "1.0.21",
  "description": "Locofy CLI",
  "keywords": [
    "figma",
    "locofy",
    "cli",
    "components",
    "design-system"
  ],
  "homepage": "https://github.com/Locofy/locofy-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/Locofy/locofy-cli.git"
  },
  "license": "MIT",
  "author": "Locofy",
  "main": "./src/index.ts",
  "bin": {
    "locofy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle:skills": "node ./src/agent/skills/bundle.mjs",
    "prebuild": "npm run bundle:skills && node -e \"const c=require('child_process').execSync('git rev-parse --short HEAD').toString().trim(); require('fs').writeFileSync('src/build-info.ts', '/** Auto-generated at build time. Do not edit manually. */\\nexport const GIT_COMMIT = \\x27'+c+'\\x27;\\n')\"",
    "build": "tsc && tsc-alias && cpy default-files dist && cpy 'src/agent/tool/tools/*.txt' dist/agent/tool/tools && cpy 'src/agent/integrate/gradle-wrapper/**/*' dist/agent/integrate/gradle-wrapper",
    "build:minify": "npm run build && npm run minify",
    "minify": "node scripts/minify.mjs",
    "postbuild": "npm run minify &&chmod +x dist/index.js",
    "link": "rimraf dist && npm run build && npm link",
    "unlink": "npm unlink @locofy/cli -g",
    "lint": "eslint . --ext .ts --fix",
    "pretest": "npm run bundle:skills",
    "test": "jest",
    "test:swiftui": "npx ts-node -r tsconfig-paths/register tests/swiftui/test-integration.ts",
    "test:swiftui:types": "npx ts-node tests/swiftui/test-type-decoder.ts",
    "test:swiftui:all": "npm run test:swiftui:types && npm run test:swiftui",
    "test-angular": "jest tests/angular/ --no-coverage"
  },
  "lint-staged": {
    "*.{js,ts,css,md}": "prettier --write"
  },
  "dependencies": {
    "@angular/cli": "21.1.4",
    "@babel/core": "^7.26.10",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "~4.1.4",
    "@vitejs/plugin-vue": "^6.0.4",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "colors-cli": "^1.0.33",
    "commander": "^13.1.0",
    "css-loader": "^7.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "dotenv-webpack": "^8.1.0",
    "enquirer": "^2.4.1",
    "file-loader": "^6.2.0",
    "form-data": "^4.0.4",
    "html-element-attributes": "^3.4.0",
    "inquirer": "^12.5.2",
    "less": "^4.3.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "mime-types": "^3.0.1",
    "mini-svg-data-uri": "^1.4.4",
    "minimatch": "^10.1.2",
    "murmurhash": "^2.0.1",
    "node-fetch": "^2.7.0",
    "open": "^10.1.1",
    "ora": "^8.2.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.6",
    "raw-loader": "^4.0.2",
    "react-docgen": "^7.1.1",
    "react-native-svg-web": "^1.0.9",
    "react-native-web": "^0.19.13",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "sharp": "^0.35.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.13",
    "terser": "^5.39.0",
    "terser-webpack-plugin": "^5.3.14",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "5.8.3",
    "uglify-js": "^3.19.3",
    "ulid": "^3.0.2",
    "url-loader": "^4.1.1",
    "vite": "^7.3.1",
    "vue-component-meta": "^2.2.12",
    "watchpack": "^2.4.2",
    "webpack": "^5.99.6",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/commander": "^2.12.5",
    "@types/jest": "^29.5.14",
    "@types/marked": "^5.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.14.1",
    "@types/node-fetch": "^2.6.12",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.2",
    "tsc-alias": "^1.8.15"
  },
  "optionalDependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-kotlin": "^0.3.7"
  },
  "overrides": {
    "uri-js": {
      "punycode": "^2.3.1"
    },
    "archiver-utils": {
      "glob": "^13.0.0"
    }
  },
  "packageManager": "yarn@1.22.22"
}
